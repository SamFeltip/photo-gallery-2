{
  "version": "0.2.0",
  "configurations": [
    {
      "args": ["dev", "--host", "127.0.0.1"],
      "console": "integratedTerminal",
      "env": {
        "ASTRO_DEV_BACKGROUND": "0"
      },
      "name": "Debug Astro",
      "program": "${workspaceFolder}/node_modules/astro/bin/astro.mjs",
      "request": "launch",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Local\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    }
  ]
}
