{
  "name": "astro-photos",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro sync && tsc --noEmit && pnpm check:provision",
    "check:provision": "tsc --ignoreConfig --noEmit --allowJs --checkJs --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck scripts/provision-activity-actors.js",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "provision:actors": "node scripts/provision-activity-actors.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.4",
    "@astrojs/react": "^6.0.4",
    "@fancyapps/ui": "^6.1.14",
    "@immich/sdk": "^3.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smartypants": "^0.2.2",
    "thumbhash": "^0.1.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@iconify-json/iconamoon": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.37",
    "@types/node": "^26.4.1",
    "astro-icon": "^1.1.5",
    "typescript": "^7.0.2"
  }
}
