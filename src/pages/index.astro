---
import { Image } from "astro:assets";
import { Font } from "astro:assets";

import "../styles/reset.css";
import "../styles/styles.css";
import LoadInTransition from "../components/LoadInTransition.astro";
import BlurhashBackground from "../components/BlurhashBackground.astro";
import { isNonExpiringAlbumShareLink } from "../lib/shareKey";
import {
  getAllAlbums,
  init,
  getAllSharedLinks,
  type AlbumResponseDto,
} from "@immich/sdk";

const IMMICH_BASE_URL = import.meta.env.IMMICH_BASE_URL;
const API_KEY = import.meta.env.API_KEY;

init({
  baseUrl: `${IMMICH_BASE_URL}/api`,
  apiKey: API_KEY,
});

const albumsResponse = await getAllAlbums({ isShared: true });

const shareLinks = await getAllSharedLinks({});

let albums = albumsResponse
  .map((album) => {
    const sharedLink = shareLinks.find((link) =>
      isNonExpiringAlbumShareLink(link, album.id),
    );
    return {
      ...album,
      sharedKey: sharedLink?.key,
    };
  })
  .filter(
    (
      album,
    ): album is AlbumResponseDto & {
      albumThumbnailAssetId: string;
      sharedKey: string;
    } =>
      album.sharedKey !== undefined &&
      album.albumThumbnailAssetId !== undefined,
  );
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Photo Gallery</title>
    <Font cssVariable="--font-unbounded" />

    <style>
      section#albums {
        display: grid;
        grid-template-columns: 1fr;
        list-style: none;
        padding: 0;
        padding-bottom: 3rem;
        margin: max(2.5vw, 12px);
        gap: 0 max(2.5vw, 12px);
      }

      .album {
        display: grid;
        grid-row: span 2;
        grid-template-rows: subgrid;
        padding-bottom: max(2.5vw, 12px);

        transition:
          scale 0.1s ease-in-out,
          border-radius 0.1s ease-in-out;
        text-decoration: none;
        color: inherit;
        text-transform: capitalize;

        &:active {
          scale: 1.02;
        }

        &:hover,
        &:focus-visible {
          outline: 3px solid var(--outline);
          outline-offset: 2px;
          scale: 1.01;
          z-index: 1;
        }

        & span {
          aspect-ratio: 4 / 3;
          height: 100%;
          width: 100%;
        }

        & div.image-wrapper {
          border-radius: 2px;
          overflow: hidden;
        }
        & img {
          aspect-ratio: 4 / 3;
          height: 100%;
          width: 100%;
          object-fit: cover;
        }
      }

      @media screen and (min-width: 400px) {
        section#albums {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media screen and (min-width: 650px) {
        section#albums {
          grid-template-columns: repeat(3, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section id="albums">
        {
          Object.values(albums)
            .toSorted(
              (a, b) =>
                new Date(b.startDate ?? 0).getTime() -
                new Date(a.startDate ?? 0).getTime(),
            )
            .map((album) => (
              <a class="album" id={album.id} href={`/${album.id}`}>
                <LoadInTransition>
                  <BlurhashBackground assetId={album.albumThumbnailAssetId}>
                    <div class="image-wrapper">
                      <Image
                        height={300}
                        width={400}
                        src={`${IMMICH_BASE_URL}/api/assets/${album.albumThumbnailAssetId}/thumbnail?key=${album.sharedKey}&size=preview`}
                        alt={album.albumName}
                      />
                    </div>
                  </BlurhashBackground>
                </LoadInTransition>
                <h2 style={{ margin: "0.5rem 0 0;" }}>{album.albumName}</h2>
              </a>
            ))
        }
      </section>
    </main>
  </body>
</html>
