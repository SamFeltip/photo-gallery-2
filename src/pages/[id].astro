---
import { Font, Image } from "astro:assets";

import "../styles/styles.css";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

import { thumbHashToDataURL } from "thumbhash";
import { init, searchStacks,getAlbumInfo, type AlbumResponseDto, getAllAlbums, type AssetResponseDto, getAssetMetadata, searchAssets, type StackResponseDto } from "@immich/sdk";
import People from "../components/People.astro";
import type { AssetStack } from "../types/assets";

export async function getStaticPaths() {
  const IMMICH_BASE_URL = import.meta.env.IMMICH_BASE_URL;
  const API_KEY = import.meta.env.API_KEY;

  init({ baseUrl: `${IMMICH_BASE_URL}/api`, apiKey: API_KEY });

  const albums = await getAllAlbums({
    isShared: true,
  });

  return albums.map((album) => ({
    params: { id: album.id },
  }));
}

const { id } = Astro.params;

const IMMICH_BASE_URL = import.meta.env.IMMICH_BASE_URL;
const API_KEY = import.meta.env.API_KEY;
init({ baseUrl: `${IMMICH_BASE_URL}/api`, apiKey: API_KEY });


// --- helper accessors (adjust here if your API shape differs) ---
function getRating(asset: AssetResponseDto) {
  // ACCESSOR SPOT 1: change if rating isn't at asset.exifInfo.rating
  return asset?.exifInfo?.rating ?? 0;
}

function getDescription(asset: AssetResponseDto) {
  return asset?.exifInfo?.description || asset?.originalFileName || "";
}



// --- fetch all stacks once, build assetId -> stackId lookup ---
// Album/asset responses don't reliably include stack membership, so we
// hit /api/stacks separately and index it ourselves.
async function getAssetIdToStackIdMap(): Promise<Map<string, StackResponseDto>> {

  const stacks = await searchStacks({});

  const map = new Map<string, StackResponseDto>();
  for (const stack of stacks) {
    // Each stack has an id and an array of member assets (including the primary).
    for (const asset of stack.assets) {
      if (asset.id) {
        map.set(asset.id, stack);
      }
    }
  }
  return map;
}

/**
 * Reads the timestamp to sort an asset by, preferring `localDateTime` and
 * falling back to `fileCreatedAt`.
 *
 * @param asset - the asset to read a timestamp from
 * @returns milliseconds since epoch, or `0` if neither field parses
 */
function getAssetTimestamp(asset: AssetResponseDto): number {
  const raw = asset.localDateTime ?? asset.fileCreatedAt;
  const time = raw ? new Date(raw).getTime() : NaN;
  return Number.isNaN(time) ? 0 : time;
}

/**
 * Builds the ordered list of {@link AssetStack} entries to display for the
 * album.
 *
 * - Assets are grouped by stack membership (an unstacked asset forms its
 *   own single-item group, keyed by its own id).
 * - A stacked group's `bestItem` is whichever member is the stack's
 *   `primaryAssetId`; if that primary asset isn't among this album's
 *   results, the whole stack is skipped (matches prior behavior, which
 *   never recorded a stack unless its primary asset was encountered).
 * - An unstacked group's `bestItem` is its asset (falling back to the
 *   highest-rated member in the unlikely case of duplicates).
 * - Groups whose `bestItem` is rated 1 or 2 stars are filtered out.
 * - The result is sorted ascending by `bestItem`'s `localDateTime`
 *   (falling back to `fileCreatedAt`).
 *
 * @returns the ordered list of display-ready asset stacks
 */
async function getDisplayAssets(): Promise<AssetStack[]> {

  const rawAssets = (await searchAssets({
      metadataSearchDto: { albumIds: [id], withPeople: true, withStacked: true, withExif: true }
    })).assets.items;

  const dedupedAssets = Array.from(
    new Map(rawAssets.map((asset) => [asset.id, asset])).values(),
  );

  // One extra request to resolve stack membership for all assets at once.
  const assetIdToStackId = await getAssetIdToStackIdMap();

  // --- group deduped assets by stack (or by their own id when unstacked) ---
  const membersByGroup = new Map<string, AssetResponseDto[]>();
  const stackByGroup = new Map<string, StackResponseDto>();

  for (const asset of dedupedAssets) {
    const stack = assetIdToStackId.get(asset.id) ?? null;
    const groupId: string = stack?.id ?? asset.id;

    if (stack != null) {
      stackByGroup.set(groupId, stack);
    }

    const members = membersByGroup.get(groupId);
    if (members) {
      members.push(asset);
    } else {
      membersByGroup.set(groupId, [asset]);
    }
  }

  // --- collapse each group down to its bestItem ---
  const groups: AssetStack[] = [];

  for (const [groupId, members] of membersByGroup) {
    const stack = stackByGroup.get(groupId);

    if (stack) {
      const bestItem = members.find((asset) => asset.id === stack.primaryAssetId);
      if (!bestItem) continue; // primary not present in this album's results

      groups.push({ id: groupId, bestItem, stackItems: members.filter(asset => asset.id !== bestItem.id) });
      continue;
    }

    // Unstacked group: normally a single asset; fall back to the
    // highest-rated member if duplicates were somehow present.
    const bestItem = members.reduce((best, asset) =>
      getRating(asset) > getRating(best) ? asset : best,
    );
    groups.push({ id: groupId, bestItem });
  }

  // --- filter out 1-star and 2-star assets, then order chronologically ---
  return groups
    .filter((group) => [null, 0, 3, 4, 5].includes(getRating(group.bestItem)))
    .sort((a, b) => getAssetTimestamp(a.bestItem) - getAssetTimestamp(b.bestItem));
}

async function getShareKey() {
  let links = null;

  if (!id) {
    throw new Error("No album id provided in route.");
  }

  const res = await fetch(`${IMMICH_BASE_URL}/api/shared-links`, {
    headers: {
      "x-api-key": API_KEY,
      Accept: "application/json",
    },
  });

  if (!res.ok) {
    throw new Error(`Failed to fetch album (${res.status} ${res.statusText})`);
  } else {
    links = await res.json();
  }

  if (!Array.isArray(links)) {
    throw new Error("Unexpected response shape for shared links.");
  }

  const link = links.find(
    (link) =>
      link.album.id === id &&
      (link.expiresAt == null || new Date(link.expiresAt) > new Date()),
  );

  if (!link) {
    throw new Error(`No shared link found for album id ${id}`);
  }

  return link.key;
}

let errorMessage = null;

let shareKey = null;
try {
  shareKey = await getShareKey();
} catch (err) {
  if (err instanceof Error) {
    errorMessage = `Error fetching shared link: ${err.message}`;
  }
}

let album: AlbumResponseDto | undefined;
let displayAssets: AssetStack[] = [];

if (errorMessage === null) {
  try {
    album = await getAlbumInfo({id: id});
    displayAssets = await getDisplayAssets();
  } catch (err) {
    if (err instanceof Error) {
      errorMessage = `Error fetching album: ${err.message}`;
    }
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Photo Gallery • {album?.albumName}</title>
    <meta name="description" content={album?.description} />
    <meta property="og:title" content={album?.albumName} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${IMMICH_BASE_URL}/api/assets/${album?.albumThumbnailAssetId}/thumbnail?key=${shareKey}&size=preview`}/>
    <meta property="og:image:alt" content={album?.description} />

    <meta property="og:description" content={album?.description} />
    <Font cssVariable="--font-unbounded" />

    <style>
      main {
        --padding: max(2.5vw, 12px);
        padding: var(--padding);
      }

      .justified-gallery {
        --scale-factor: 1.01;
        --space: clamp(12px, 1.25vw, 6px);
        --min-height: clamp(200px, 20vw, 400px);

        display: flex;
        flex-wrap: wrap;
        gap: var(--space);

        padding-bottom: 3rem;

        .thumbhash-img {
          --border-radius: 2px;
          border-radius: var(--border-radius);
          overflow: hidden;

          &:hover,&:focus-visible {
            border-radius: calc(var(--border-radius) * var(--scale-factor))
          }
        }

        a {
          flex-grow: calc(var(--width) * (100000 / var(--height)));
          flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
          aspect-ratio: var(--width) / var(--height);
          overflow: hidden;
          opacity: 1;
          transition: all 0.05s ease-in-out;
          
          img {
            display: block;
            object-fit: cover;
            height: 100%;
            width: 100%;
          }

          &:hover,&:focus-visible {
            outline: 3px solid var(--outline);
            outline-offset: 2px;
            scale: var(--scale-factor);
            z-index: 1;
          }

          &.hidden {
            transition: opacity 0.4s ease-in-out;
            opacity: 0;
          }
        }
        &::after {
          content: " ";
          flex-grow: 1000000000;
        }
      }
    </style>
  </head>
  <body>
    <main>
      {
        errorMessage || album === undefined ? (
          <p>{errorMessage}</p>
        ) : (
          <h1><a href="/">{album.albumName}</a></h1>

          <People album={album} displayAssets={displayAssets}/>

          <section class="justified-gallery" id="photoswipe">
            {displayAssets
              .map((asset) => {
                const height = Number(asset.bestItem.exifInfo?.exifImageHeight) ?? 1;
                const width = Number(asset.bestItem.exifInfo?.exifImageWidth) ?? 1;

                const orientation = [8, 6].includes(
                  Number(asset.bestItem.exifInfo?.orientation),
                )
                  ? "portrait"
                  : "landscape";

                const imgHeight = orientation === "portrait" ? width : height;
                const imgWidth = orientation === "portrait" ? height : width;

                // helper: base64 string -> Uint8Array (Node has atob globally in Astro's runtime)
                function toDataUrl(base64Hash: string) {
                  const binary = atob(base64Hash);
                  const bytes = new Uint8Array(binary.length);
                  for (let i = 0; i < binary.length; i++) {
                    bytes[i] = binary.charCodeAt(i);
                  }
                  return thumbHashToDataURL(bytes);
                }

                const placeholder = asset.bestItem.thumbhash ? toDataUrl(asset.bestItem.thumbhash) : null;

                const peopleIds = Object.fromEntries(
                  asset.bestItem.people?.map(person => ["data-person", person.id]) ?? []
                );

                return (
                  <>
                  <a
                    style={`--width: ${imgWidth}; --height: ${imgHeight}; --placeholder-url: url(${placeholder});`}
                    href={`${IMMICH_BASE_URL}/api/assets/${asset.bestItem.id}/thumbnail?key=${shareKey}&size=fullsize`}
                    target="_blank"
                    data-fancybox={asset.id}
                    class="thumbhash-img"
                    {...peopleIds}
                  >
                    <Image
                      id={asset.bestItem.id}
                      class="loadIn"
                      width={imgWidth}
                      height={imgHeight}
                      src={`${IMMICH_BASE_URL}/api/assets/${asset.bestItem.id}/thumbnail?key=${shareKey}&size=preview`}
                      alt={getDescription(asset.bestItem)}
                    />
                    {asset.bestItem.people?.map(person => <span style={{display: "none"}} class="data-person-id" data-person={person.id}></span>)}
                  </a>
                  {
                    asset.stackItems?.map(stackAsset => {
                      const stackAssetHeight = Number(stackAsset.exifInfo?.exifImageHeight) ?? 1;
                      const stackAssetWidth = Number(stackAsset.exifInfo?.exifImageWidth) ?? 1;

                      return (<div style={{display: "none"}}>
                        <a data-fancybox={asset.id} href={`${IMMICH_BASE_URL}/api/assets/${stackAsset.id}/thumbnail?key=${shareKey}&size=fullsize`}>
                          <Image
                            id={stackAsset.id}
                            width={stackAssetWidth}
                            height={stackAssetHeight}
                            
                            src={`${IMMICH_BASE_URL}/api/assets/${stackAsset.id}/thumbnail?key=${shareKey}&size=preview`}
                            alt={getDescription(stackAsset)}
                          />
                        </a>
                      </div>)
                    })
                  }
                  </>
                );
              })}
          </section>
        )
      }
    </main>

    <script>
      import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

      Fancybox.bind("[data-fancybox]", {
        theme: "auto",
        mainStyle: {
          "--f-button-width": "44px",
          "--f-button-height": "44px",
          "--f-button-border-radius": "50%",
          "--f-toolbar-padding": "16px",
        },
        Carousel: {
          Arrows: false,
          Toolbar: {
            display: {
              left: [],
              middle: [],
              right: ["close"],
            },
          },
          transition: "slide",
        },
      });
    </script>
    <script>
      function markLoaded(img: HTMLImageElement) {
        img.classList.add("loaded");
      }

      document
        .querySelectorAll("img.loadIn")
        .forEach((img: Element) => {
          const htmlImg = img as HTMLImageElement;
          if (htmlImg.complete && htmlImg.naturalWidth > 0) {
            // already loaded from cache — no fade needed, just show it
            markLoaded(htmlImg);
          } else {
            htmlImg.addEventListener("load", () => markLoaded(htmlImg), {
              once: true,
            });
          }
        });
    </script>
    <script>
      import { type PersonEventDetails } from "../types/events";

      const main = document.querySelector("main");

      const filteredPeople = new Set();

      main?.addEventListener("person", (e:CustomEventInit<PersonEventDetails>) => {
        if(!e.detail){
          throw new Error("no details were added to person event.");
        }

        const {personId, status} = e.detail;

        if(status == "active"){
          filteredPeople.add(personId);
        }else{
          filteredPeople.delete(personId);
        }
        
        const allPersonImages = document.querySelectorAll(`a.thumbhash-img`);
        allPersonImages.forEach(anchor => anchor.classList.remove("show"));

        let queryString = "a.thumbhash-img";
        Array.from(filteredPeople).forEach(personIdFilter => {
          queryString += `:has(span[data-person='${personIdFilter}'])`
        });

        const personImages = document.querySelectorAll(queryString);
        personImages.forEach(anchor => anchor.classList.add("show"));

        const photoList = document.querySelector(`section#photoswipe`);
        if(filteredPeople.size === 0){
          photoList?.classList.remove("filtered");
        }else{
          photoList?.classList.add("filtered");
        }
        
        // const personImages = document.querySelectorAll(`a.thumbhash-img[data-person=${personId}]`);

      })
    </script>
    <style>
      #photoswipe.filtered a.show {
        display: inherit;
      }
      
      #photoswipe.filtered a {
        display: none;
      }
    </style>
  </body>
</html>
