---
import { Font } from "astro:assets";

import "../styles/reset.css";
import "../styles/styles.css";

import { init, getAlbumInfo, type AlbumResponseDto } from "@immich/sdk";
import AssetImg from "../components/AssetImg.astro"
import Gallery from "../components/Gallery.astro";
import GalleryFilter from "../components/GalleryFilter.astro";
import LoadInTransition from "../components/LoadInTransition.astro";
import BlurhashBackground from "../components/BlurhashBackground.astro";

import type { AssetStack } from "../types/assets";
import { getDisplayAssets } from "../lib/displayAssetHelpers";
import { getShareKey } from "../lib/shareKey";

const { id } = Astro.params;

const IMMICH_BASE_URL = import.meta.env.IMMICH_BASE_URL;
const API_KEY = import.meta.env.API_KEY;
init({ baseUrl: `${IMMICH_BASE_URL}/api`, apiKey: API_KEY });

let errorMessage = null;

let shareKey = null;
try {
  shareKey = await getShareKey(id);
} catch (err) {
  if (err instanceof Error) {
    errorMessage = `Error fetching shared link: ${err.message}`;
  }
}

let album: AlbumResponseDto | undefined;
let displayAssets: AssetStack[] = [];

if (errorMessage === null) {
  try {
    album = await getAlbumInfo({id: id});
    displayAssets = await getDisplayAssets(id);
  } catch (err) {
    if (err instanceof Error) {
      errorMessage = `Error fetching album: ${err.message}`;
    }
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Photo Gallery • {album?.albumName}</title>
    <meta name="description" content={album?.description} />
    <meta property="og:title" content={album?.albumName} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${IMMICH_BASE_URL}/api/assets/${album?.albumThumbnailAssetId}/thumbnail?key=${shareKey}&size=preview`}/>
    <meta property="og:image:alt" content={album?.description} />

    <meta property="og:description" content={album?.description} />
    
    <Font cssVariable="--font-unbounded" />
    <Font cssVariable="--font-overpass" />

    <!-- <style is:global>
      .thumbhash-background {
        display: contents;
      }

      .thumbhash-background > :first-child {
        background-image: var(--placeholder-url);
        background-size: cover;
        background-repeat: no-repeat;
      }
    </style> -->
    <style>
      main {
        --padding: max(2.5vw, 12px);
        padding: var(--padding);
      }
    </style>
  </head>
  <body>
    <template id="heart">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-8-4.4-8-11a4.5 4.5 0 0 1 8-2.7A4.5 4.5 0 0 1 20 10c0 6.6-8 11-8 11Z" fill="currentColor" /></svg>
    </template>
    <template id="heart-button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-8-4.4-8-11a4.5 4.5 0 0 1 8-2.7A4.5 4.5 0 0 1 20 10c0 6.6-8 11-8 11Z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    </template>
    <template id="heart-button-filled">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-8-4.4-8-11a4.5 4.5 0 0 1 8-2.7A4.5 4.5 0 0 1 20 10c0 6.6-8 11-8 11Z" fill="currentColor" /></svg>
    </template>

    <main album-id={id}>
      {
        errorMessage || album === undefined ? (
          <p>{errorMessage}</p>
        ) : (
          <h1><a href="/">{album.albumName}</a></h1>

          <GalleryFilter album={album} displayAssets={displayAssets}>
              <Gallery albumId={id}>
                {displayAssets
                  .map((asset, index) => {
                    return (
                      <span class="asset-wrapper" style={{display: "contents"}}>
                        <LoadInTransition>
                          <BlurhashBackground asset={asset.bestItem}>
                            <AssetImg asset={asset} shareKey={shareKey} lazy={index > 6}/>
                          </BlurhashBackground>
                        </LoadInTransition>
                      </span>
                    );
                  })}
              </Gallery>
          </GalleryFilter>
        )
      }
    </main>
  </body>
</html>
