---
import type { AssetStack } from "../types/assets";
import { Image } from "astro:assets";
import { type AssetResponseDto } from "@immich/sdk";

const IMMICH_BASE_URL = import.meta.env.IMMICH_BASE_URL;

interface Props {
  shareKey: string;
  asset: AssetStack;
  fancyboxGroup: string;
  lazy: boolean;
  tagIds?: string[];
}

const { lazy, asset, fancyboxGroup, shareKey, tagIds = [] } = Astro.props;

function getDescription(asset: AssetResponseDto) {
  return asset.exifInfo?.description || asset.originalFileName;
}

const height = Number(asset.bestItem.exifInfo?.exifImageHeight) ?? 1;
const width = Number(asset.bestItem.exifInfo?.exifImageWidth) ?? 1;

const orientation = [8, 6].includes(
  Number(asset.bestItem.exifInfo?.orientation),
)
  ? "portrait"
  : "landscape";

const imgHeight = orientation === "portrait" ? width : height;
const imgWidth = orientation === "portrait" ? height : width;

const peopleIds = asset.bestItem.people?.map(({ id }) => id) ?? [];
---

<style>
  a.thumbhash-img {
    --border-radius: 2px;
    border-radius: var(--border-radius);
    overflow: hidden;

    --min-height: clamp(200px, 20vw, 400px);

    flex-grow: calc(var(--width) * (100000 / var(--height)));
    flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
    aspect-ratio: var(--width) / var(--height);
    opacity: 1;
    transition: all 0.05s ease-in-out;

    img {
      display: block;
      object-fit: cover;
      height: 100%;
      width: 100%;
    }

    &:hover,
    &:focus-visible {
      border-radius: calc(var(--border-radius) * var(--scale-factor));
      outline: 3px solid var(--outline);
      outline-offset: 2px;
      scale: var(--scale-factor);
      z-index: 1;
    }

    &.hidden {
      transition: opacity 0.4s ease-in-out;
      opacity: 0;
    }
  }
</style>
<a
  style={`
  --width: ${imgWidth}; 
  --height: ${imgHeight};
  `}
  href={`${IMMICH_BASE_URL}/api/assets/${asset.bestItem.id}/thumbnail?key=${shareKey}&size=fullsize`}
  data-download-src={`${IMMICH_BASE_URL}/api/assets/${asset.bestItem.id}/thumbnail?key=${shareKey}&size=preview`}
  data-prefetch-src={`${IMMICH_BASE_URL}/api/assets/${asset.bestItem.id}/thumbnail?key=${shareKey}&size=fullsize`}
  data-asset-id={asset.bestItem.id}
  target="_blank"
  data-fancybox={fancyboxGroup}
  class="thumbhash-img"
  data-people={peopleIds.join(",")}
  data-tags={tagIds.join(",")}
>
  <div style={{ position: "relative" }}>
    <div
      style={{
        color: "white",
        position: "absolute",
        zIndex: 1,
        bottom: 0,
        padding: "0.2rem",
      }}
      class="heart-wrapper"
    >
    </div>
    {
      asset.stackItems !== undefined && (
        <div
          style={{
            display: "flex",
            alignItems: "center",
            color: "white",
            position: "absolute",
            zIndex: 1,
            top: 0,
            right: 0,
            padding: "0.2rem",
          }}
        >
          <p
            style={{
              fontFamily: "var(--font-overpass)",
              fontSize: "0.7rem",
              textBoxEdge: "cap alphabetic",
              textBoxTrim: "trim-both",
            }}
          >
            {asset.stackItems?.length + 1}
          </p>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="1em" height="1em">
            <path d="M4 6h12v12H4zM8 2h12v12" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </div>
      )
    }
    <Image
      id={asset.bestItem.id}
      width={imgWidth}
      height={imgHeight}
      src={`${IMMICH_BASE_URL}/api/assets/${asset.bestItem.id}/thumbnail?key=${shareKey}&size=preview`}
      alt={getDescription(asset.bestItem)}
      loading={lazy ? "lazy" : "eager"}
    />
  </div>

  {
    asset.bestItem.people?.map((person) => (
      <span
        style={{ display: "none" }}
        class="data-person-id"
        data-person={person.id}
      />
    ))
  }
</a>
{
  asset.stackItems?.map((stackAsset) => {
    const stackAssetHeight = Number(stackAsset.exifInfo?.exifImageHeight) ?? 1;
    const stackAssetWidth = Number(stackAsset.exifInfo?.exifImageWidth) ?? 1;

    return (
      <div style={{ display: "none" }}>
        <a
          data-fancybox={fancyboxGroup}
          href={`${IMMICH_BASE_URL}/api/assets/${stackAsset.id}/thumbnail?key=${shareKey}&size=fullsize`}
          data-download-src={`${IMMICH_BASE_URL}/api/assets/${stackAsset.id}/thumbnail?key=${shareKey}&size=preview`}
          data-asset-id={stackAsset.id}
          data-prefetch-src={`${IMMICH_BASE_URL}/api/assets/${stackAsset.id}/thumbnail?key=${shareKey}&size=fullsize`}
        >
          <Image
            id={stackAsset.id}
            width={stackAssetWidth}
            height={stackAssetHeight}
            src={`${IMMICH_BASE_URL}/api/assets/${stackAsset.id}/thumbnail?key=${shareKey}&size=preview`}
            alt={getDescription(stackAsset)}
            loading="lazy"
          />
        </a>
      </div>
    );
  })
}
