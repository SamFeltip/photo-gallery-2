---
import type { AlbumResponseDto } from "@immich/sdk";
import People from "../components/People.astro";
import type { AssetStack } from "../types/assets";
import Tags from "./Tags.astro";
import type { GalleryTag } from "@/lib/galleryTags";
import GallerySelection from "./GallerySelection.astro";

interface Props {
  album: AlbumResponseDto;
  displayAssets: AssetStack[];
  tags: GalleryTag[];
}

const { album, displayAssets, tags } = Astro.props;
---

<div id="gallery-filter">
  <People album={album} displayAssets={displayAssets} />
  <Tags tags={tags} />
  <GallerySelection albumId={album.id} />

  <p class="gallery-results" data-gallery-result-count aria-live="polite">
    {displayAssets.length} of {displayAssets.length} photos
  </p>

  <div id="photoswipe">
    <slot />
  </div>
  <div class="gallery-empty" data-gallery-empty hidden>
    <h2>No matching photos</h2>
    <p>Try clearing a tag or face filter.</p>
  </div>
</div>

<script>
  import { installGalleryFiltering } from "@/lib/galleryFiltering";
  installGalleryFiltering();
</script>
<style>
  :global(.gallery-filter-hidden) { display: none !important; }
  .gallery-results { margin: 0 0 0.8rem; opacity: 0.72; font-size: 0.9rem; }
  .gallery-empty { padding: 4rem 1rem; text-align: center; }
  .gallery-empty h2 { margin: 0; }
  .gallery-empty p { margin: 0.5rem 0 0; opacity: 0.68; }
</style>
