---
// this gallery component is a wrapper for the photoswipe functionality
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import { FancyboxDrawerIsland } from "./FancyboxDrawerIsland";

interface Props {
  albumId: string;
}

const { albumId } = Astro.props;
---

<style>
  .justified-gallery {
    --scale-factor: 1.01;

    display: flex;
    flex-wrap: wrap;
    gap: clamp(12px, 1.25vw, 6px);

    padding-bottom: 3rem;

    &::after {
      content: " ";
      flex-grow: 1000000000;
    }
  }
</style>
<section class="justified-gallery">
  <!-- should contain [data-fancybox] elements -->
  <slot />
</section>
<FancyboxDrawerIsland albumId={albumId} client:load />
<script>
  import {
    clickHeartButton,
    initHeartButtonIcon,
    refreshHearts,
    setHeartButtonState,
  } from "../lib/fancyboxHeartButtonHelpers";
  import { actions } from "astro:actions";
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";
  import { isGuestLoved } from "@/lib/guestActivity";
  import {
    getNeighborIndexes,
    installIntentPrefetch,
    prefetchImage,
  } from "@/lib/imagePrefetch";

  function getCurrentAssetId(instance: CarouselInstance) {
    const slide = instance.getPage().slides[0];
    return "assetId" in slide && typeof slide.assetId === "string"
      ? slide.assetId
      : null;
  }

  function openDrawer(instance: CarouselInstance) {
    const assetId = getCurrentAssetId(instance);
    if (!assetId) return;
    (document.activeElement as HTMLElement | null)?.blur();
    window.dispatchEvent(new CustomEvent("open-fancybox-drawer", { detail: { assetId } }));
  }

  function closeDrawer() {
    window.dispatchEvent(new Event("close-fancybox-drawer"));
  }

  function prefetchCarouselNeighbors(instance: CarouselInstance) {
    const slides = instance.getOption("slides");
    for (const index of getNeighborIndexes(instance.getPageIndex(), slides.length)) {
      const slide = slides[index];
      if ("src" in slide && typeof slide.src === "string") prefetchImage(slide.src);
    }
  }

  async function updateCommentBubble(instance: CarouselInstance) {
    const assetId = getCurrentAssetId(instance);
    const slide = instance.getPage().slides[0];
    if (!assetId || !slide.el) return;

    const existing = slide.el.querySelector<HTMLButtonElement>(
      ".fancybox-comment-bubble",
    );
    const button = existing ?? document.createElement("button");
    if (!existing) {
      button.className = "fancybox-comment-bubble";
      button.type = "button";
      button.style.cssText = "backdrop-filter:blur(12px);background:rgba(18,18,22,.78);border:1px solid rgba(255,255,255,.16);border-radius:14px;bottom:16px;color:white;cursor:pointer;display:grid;gap:2px;max-width:min(28rem,calc(100% - 32px));overflow:hidden;padding:9px 12px;position:absolute;right:16px;text-align:left;z-index:30;";
      button.addEventListener("click", () => openDrawer(instance));
      slide.el.append(button);
    }

    try {
      const { data, error } = await actions.getPhotoActivities({
        albumId,
        assetId,
      });
      if (error) return;
      const comments = data.activities
        .filter(({ type, comment }) => type === "comment" && comment)
        .sort((left, right) => Date.parse(right.createdAt) - Date.parse(left.createdAt));
      const latestComment = comments[0];
      button.replaceChildren();
      if (latestComment?.comment) {
        const author = document.createElement("strong");
        author.textContent = latestComment.user.name;
        author.style.cssText = "font-size:.76rem;line-height:1.2;opacity:.78;";
        const preview = document.createElement("span");
        preview.textContent = latestComment.comment;
        preview.style.cssText = "display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
        button.append(author, preview);
      } else {
        button.textContent = "Add a comment";
      }
      button.title = `${data.statistics.comments} comment${data.statistics.comments === 1 ? "" : "s"}`;

      const heartButton = instance
        .getContainer()
        ?.querySelector<HTMLButtonElement>("button.heart-carosel");
      if (heartButton) {
        setHeartButtonState(
          heartButton,
          data.statistics.likes > 0 || isGuestLoved(albumId, assetId),
        );
        heartButton.title = `${data.statistics.likes + (isGuestLoved(albumId, assetId) ? 1 : 0)} loves`;
      }
    } catch {
      button.textContent = "Comments";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    refreshHearts();
    installIntentPrefetch();
  });
  window.addEventListener("immich-activity-changed", () => {
    const instance = Fancybox.getInstance();
    if (instance) void updateCommentBubble(instance);
  });

  Fancybox.bind("[data-fancybox]", {
    // Vaul is the only modal layer. This keeps Fancybox below its portal and
    // prevents two modal focus traps from fighting each other.
    modal: false,
    keyboard: {
      Escape: false,
    },
    theme: "auto",
    mainStyle: {
      "--f-button-width": "44px",
      "--f-button-height": "44px",
      "--f-button-border-radius": "50%",
      "--f-toolbar-padding": "16px",
    },
    Carousel: {
      Arrows: false,
      Toolbar: {
        items: {
          heart: {
            tpl: `<button class="f-button heart-carosel"></button>`,
            click: clickHeartButton,
          },
          drawer: {
            tpl: `<button class="f-button" type="button" title="Open drawer" aria-label="Open drawer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9h14M5 15h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>`,
            click: openDrawer,
          },
        },
        display: {
          left: [],
          middle: [],
          right: ["download", "heart", "drawer", "close"],
        },
      },
      transition: "slide",
      on: {
        contentLoading: (instance) => {
          initHeartButtonIcon(instance);
          prefetchCarouselNeighbors(instance);
          void updateCommentBubble(instance);
        },
        change: (instance) => {
          initHeartButtonIcon(instance);
          prefetchCarouselNeighbors(instance);
          void updateCommentBubble(instance);
        },
      },
    },
    on: {
      destroy: closeDrawer,
    },
  });
</script>
