---

---

<span class="loadIn" style={{ display: "contents" }}>
  <slot />
</span>

<script>
  function markLoaded(img: HTMLImageElement) {
    img.classList.add("loaded");
  }

  document
    .querySelectorAll<HTMLImageElement>("span.loadIn img")
    .forEach((htmlImg) => {
      console.log("LoadInTransition: checking image", htmlImg.src);
      if (htmlImg.complete && htmlImg.naturalWidth > 0) {
        // already loaded from cache — no fade needed, just show it
        markLoaded(htmlImg);
      } else {
        htmlImg.addEventListener("load", () => markLoaded(htmlImg), {
          once: true,
        });
      }
    });
</script>
<style>
  .loadIn :global(img) {
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.2s ease-in-out,
      transform 0.3s ease-in-out;

    &.loaded {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
